#pragma code_page(65001)
// Template: build.rs fills in the @…@ values and compiles the result.
1 ICON "@RES_DIR@/pinwheel.ico"
1 24 "@OUT_DIR@/pinwheel.manifest"

1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Pinwheel"
      VALUE "LegalCopyright", "Copyright (c) 2026 Kewin Dousse, MIT License"
      VALUE "ProductName", "Pinwheel"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "OriginalFilename", "pinwheel.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
